/* Physical key positions, derived from the upstream Hillside KLE source
 * (github.com/mmccoyd/hillside/wiki/hill_46/keyboard-layout-editor.json),
 * re-ordered to match the key-position numbering in default_transform
 * (see hillside46.dtsi) and documented in
 * urob/zmk-helpers include/zmk-helpers/key-labels/hillside46.h.
 */

#include <physical_layouts.dtsi>

/ {
    hillside46_layout: hillside46_layout {
        compatible = "zmk,physical-layout";
        display-name = "Hillside 46";

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100     0   112 (-1000)   200   350>
            , <&key_physical_attrs 100 100   100   112 (-1000)   200   350>
            , <&key_physical_attrs 100 100   200    41  (-500)   300   300>
            , <&key_physical_attrs 100 100   300     0       0     0     0>
            , <&key_physical_attrs 100 100   400    32       0     0     0>
            , <&key_physical_attrs 100 100   500    47       0     0     0>
            , <&key_physical_attrs 100 100   950    47       0     0     0>
            , <&key_physical_attrs 100 100  1050    32       0     0     0>
            , <&key_physical_attrs 100 100  1150     0       0     0     0>
            , <&key_physical_attrs 100 100  1250    41     500  1250   300>
            , <&key_physical_attrs 100 100  1350   112    1000  1350   350>
            , <&key_physical_attrs 100 100  1450   112    1000  1350   350>
            , <&key_physical_attrs 100 100     0   212 (-1000)   200   350>
            , <&key_physical_attrs 100 100   100   212 (-1000)   200   350>
            , <&key_physical_attrs 100 100   200   141  (-500)   300   300>
            , <&key_physical_attrs 100 100   300   100       0     0     0>
            , <&key_physical_attrs 100 100   400   132       0     0     0>
            , <&key_physical_attrs 100 100   500   147       0     0     0>
            , <&key_physical_attrs 100 100   950   147       0     0     0>
            , <&key_physical_attrs 100 100  1050   132       0     0     0>
            , <&key_physical_attrs 100 100  1150   100       0     0     0>
            , <&key_physical_attrs 100 100  1250   141     500  1250   300>
            , <&key_physical_attrs 100 100  1350   212    1000  1350   350>
            , <&key_physical_attrs 100 100  1450   212    1000  1350   350>
            , <&key_physical_attrs 100 100     0   312 (-1000)   200   350>
            , <&key_physical_attrs 100 100   100   312 (-1000)   200   350>
            , <&key_physical_attrs 100 100   200   241  (-500)   300   300>
            , <&key_physical_attrs 100 100   300   200       0     0     0>
            , <&key_physical_attrs 100 100   400   232       0     0     0>
            , <&key_physical_attrs 100 100   500   247       0     0     0>
            , <&key_physical_attrs 100 100   342   332       0     0     0>
            , <&key_physical_attrs 100 100  1110   332       0     0     0>
            , <&key_physical_attrs 100 100   950   247       0     0     0>
            , <&key_physical_attrs 100 100  1050   232       0     0     0>
            , <&key_physical_attrs 100 100  1150   200       0     0     0>
            , <&key_physical_attrs 100 100  1250   241     500  1250   300>
            , <&key_physical_attrs 100 100  1350   312    1000  1350   350>
            , <&key_physical_attrs 100 100  1450   312    1000  1350   350>
            , <&key_physical_attrs 100 100   342   332    1500   392   810>
            , <&key_physical_attrs 100 100   342   332    3000   392   810>
            , <&key_physical_attrs 100 100   342   232    3000   392   810>
            , <&key_physical_attrs 100 100   342   332    4500   392   810>
            , <&key_physical_attrs 100 100  1110   332 (-4500)  1160   810>
            , <&key_physical_attrs 100 100  1110   232 (-3000)  1160   810>
            , <&key_physical_attrs 100 100  1110   332 (-3000)  1160   810>
            , <&key_physical_attrs 100 100  1110   332 (-1500)  1160   810>
            ;
    };
