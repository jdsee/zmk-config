#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define QWERTY_L 0
#define DVORAK_L 1
#define COLEMK_L 2
#define NAV_L    3
#define SYM_L    4
#define ADJ_L    5
#define UML_L    8
#define Undo   LC(Z)
#define Cut    LC(X)
#define Copy   LC(C)
#define Paste  LC(V)
#define Redo   LC(Y)

/ {
    behaviors {
        /* Re-tapping within this window after a tap always repeats the tap,
         * so holding the thumb keys for auto-repeat (GUI/BACKSPACE, TAB, ENTER)
         * works instead of triggering the hold behavior. Only applied to these
         * thumb-key variants, not the global &mt/&lt, so home-row CTRL/ESC etc.
         * keep the normal tap-hold decision.
         */

        mt_qt: mod_tap_quick_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            bindings = <&kp>, <&kp>;
        };

        lt_qt: layer_tap_quick_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        /* Diaeresis dead-key (Option on macOS, AltGr under Linux's
         * altgr-intl layout): tap RA(U) to arm it, then the target vowel.
         * ss on Windows has no dead-key equivalent, so it isn't covered
         * here - see um_sz_win below. */

        um_ae: um_ae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(U) &kp A>;
        };

        um_oe: um_oe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(U) &kp O>;
        };

        um_ue: um_ue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(U) &kp U>;
        };

        /* Windows has no AltGr/dead-key path to ss at all - fall back to
         * the native Alt+Numpad ANSI code (0223), held across all four
         * digits. No layout change required. */

        um_sz_win: um_sz_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N3>,
                <&macro_release>,
                <&kp LALT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        lshift {
            bindings = <&kp LSHIFT>;
            key-positions = <15 16>;
        };

        rshift {
            bindings = <&kp RSHFT>;
            key-positions = <19 20>;
        };

        caps_lock {
            bindings = <&caps_word>;
            key-positions = <16 19>;
        };

        ctrl_on_sym_num {
            bindings = <&kp RCTRL>;
            key-positions = <41 23>;
        };

        /* Leader-key umlauts: tap SEMI then one of these within the combo
         * window to get the umlaut instead of ';' + the letter. require-
         * prior-idle-ms guards against normal words ending in s/a/o/u
         * immediately before a statement-terminating ';' (e.g. "items;",
         * "data;", "menu;") - that's fast in-flow typing with no pause, so
         * it won't satisfy the idle check and ';' + letter type normally.
         * Deliberately reaching for ';' to trigger an umlaut does have that
         * pause, so it still fires. Plain ';' alone is unaffected either
         * way - it's still bound to &kp SEMICOLON and only gets swallowed
         * when a trigger letter actually follows in time. */
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* QWERTY
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | `     |   Q   |   W   |   E   |   R   |   T   |-----------------------------------|   Y   |   U   |   I   |   O   |   P   | BKSPC |
 * | TAB   |   A   |   S   |   D   |   F   |   G   |-----------------------------------|   H   |   J   |   K   |   L   |   ;   | ENTER |
 * | CTRL  |   Z   |   X   |   C   |   V   |   B   |  ESC  |-------------------|  CAPS |   N   |   M   |   ,   |   .   |   /   |   '   |
 *                                 |  GUI  |  ALT  |SK SHFT|  Nav  |---|  Sym  | SPACE |  ALT  |  GUI  |
 */

            bindings = <
&kp TAB               &kp Q  &kp W  &kp E  &kp R          &kp T                                                                                   &kp Y      &kp U  &kp I      &kp O    &kp P          &kp MINUS
&mt LEFT_CONTROL ESC  &kp A  &kp S  &kp D  &kp F          &kp G                                                                                   &kp H      &kp J  &kp K      &kp L    &kp SEMICOLON  &kp SQT
&sk LALT              &kp Z  &kp X  &kp C  &kp V          &kp B          &mt C_PREV DEL                                  &mt C_PLAY_PAUSE C_NEXT  &kp N      &kp M  &kp COMMA  &kp DOT  &kp SLASH      &kp RALT
                                           &lt (3) LC(Z)  &kp BACKSPACE  &kp LEFT_GUI    &lt_qt 1 TAB    &lt_qt 2 ENTER  &sk RSHIFT               &kp SPACE  &sl 8
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_pad_media {
            bindings = <
&kp BACKSPACE  &none  &kp C_BRI_DN  &none       &kp C_BRI_UP  &none                                             &kp LC(N6)     &kp N7  &kp N8  &kp N9  &kp PLUS   &kp MINUS
&kp LCTRL      &mo 3  &kp C_PREV    &kp C_PP    &kp C_NEXT    &kp LG(M)                                         &kp EQUAL      &kp N4  &kp N5  &kp N6  &kp ASTRK  &kp RCTRL
&trans         &none  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &none      &trans                         &trans  &kp BACKSPACE  &kp N1  &kp N2  &kp N3  &kp SLASH  &trans
                                                &trans        &trans     &trans  &trans    &lt_qt 4 N0  &trans  &trans         &trans
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_nav {
            bindings = <
&kp TILDE  &kp EXCL       &kp AT    &kp HASH  &kp DOLLAR  &kp PERCENT                                          &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR       &kp PLUS
&kp LCTRL  &kp GRAVE      &kp LPAR  &kp LBKT  &kp LBRC    &kp EQUAL                                            &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp GRAVE      &kp RCTRL
&trans     &kp BACKSLASH  &kp RPAR  &kp RBKT  &kp RBRC    &kp PIPE     &trans                   &trans         &kp PIPE   &kp LBKT   &kp RBKT   &trans     &kp BACKSLASH  &trans
                                              &trans      &trans       &trans  &mo 4    &trans  &kp RIGHT_ALT  &trans     &kp K_APP
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn_keys {
            bindings = <
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans                                    &kp F10  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans                                    &kp F11  &kp F4  &kp F5  &kp F6  &kp F11  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans  &trans                    &trans  &kp F12  &kp F1  &kp F2  &kp F3  &kp F12  &trans
                                  &trans   &trans  &trans  &trans    &trans  &trans  &trans   &trans
            >;
        };

        adj_layer {
            /* ADJUST
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |       | QWERTY| DVORAK| COLEMK|       |       |-----------------------------------|       |  F11  |  F12  |Prt Scr|EP_OFF | EP_ON |
 * | RESET | BT 0  | BT 1  | BT 2  | BT 3  | BT 4  |-----------------------------------|       |       |       |       |       | RESET |
 * |       | LALT  | LGUI  | LCTRL | LSHIFT|       |BT CLR |-------------------|       |       |       |OUT_USB|OUT_BLE|       | BOOTL |
 *                                 |       |       |       |       |---|       |       |       |       |
 */

            bindings = <
&bootloader  &to 0         &to 0         &to 0         &none         &kp N1                                                      &none         &kp F11       &kp F12       &kp PRINTSCREEN  &ext_power EP_OFF  &bootloader
&sys_reset   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                                &out OUT_BLE  &out OUT_TOG  &out OUT_USB  &none            &ext_power EP_ON   &sys_reset
&bootloader  &kp LALT      &kp LGUI      &kp LCTRL     &kp LSHIFT    &none         &bt BT_CLR                    &bt BT_CLR_ALL  &none         &none         &none         &none            &none              &bootloader
                                                       &trans        &trans        &trans      &trans    &trans  &trans          &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        kb_config {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &kp N2                                                      &trans        &trans        &trans        &trans  &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                                &out OUT_BLE  &out OUT_TOG  &out OUT_USB  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &bt BT_CLR                    &bt BT_CLR_ALL  &trans        &trans        &trans        &trans  &trans  &trans
                                                  &trans        &trans        &trans      &trans    &trans  &trans          &trans        &trans
            >;
        };

        num_sym_layer {
            bindings = <
&kp TILDE  &kp N1           &kp N2     &kp N3    &kp N4      &kp N5                                             &kp N6     &kp N7     &kp N8     &kp N9     &kp N0         &kp PLUS
&kp LCTRL  &kp EXCLAMATION  &kp AT     &kp HASH  &kp DOLLAR  &kp PERCENT                                        &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR       &kp RCTRL
&trans     &kp BACKSLASH    &kp GRAVE  &kp LBRC  &kp RBRC    &kp EQUAL    &trans                    &trans      &kp PIPE   &kp LBKT   &kp RBKT   &kp EQUAL  &kp BACKSLASH  &trans
                                                 &trans      &trans       &trans  &trans    &trans  &kp RSHIFT  &trans     &kp K_APP
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn_layer {
            /* NAV   
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | Copy  |   1   |   2   |   3   |   4   |   5   |-----------------------------------|   6   |   7   |   8   |   9   |   0   | BSPC  |
 * | Cut   |  GUI  |  Alt  | Ctrl  | Shift | Paste |-----------------------------------| PG UP |  Left |  Up   |  Down | Right | PG DN |
 * | Ctrl  |  F1   |  F2   |  F3   |  F4   |  F5   |  UnDo |-------------------| ReDo  |  F6   |  F7   |  F8   |  F9   |  F10  | Ctrl  |
 *                                 |       |       |       |       |---| ADJ_L |       |       |       |
 */

            bindings = <
&kp F12    &kp F1         &kp F2        &kp F3      &kp F4        &kp F5                                          &kp F6    &kp F7     &kp F8     &kp F9     &kp F10          &kp F11
&kp LCTRL  &kp C_BRI_DEC  &kp C_PREV    &kp C_PP    &kp C_NEXT    &kp C_BRI_UP                                    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp PRINTSCREEN  &kp RCTRL
&trans     &none          &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &none         &trans                    &trans  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &none            &trans
                                                    &trans        &trans        &trans  &trans    &trans  &trans  &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        uml_layer {
            /* UMLAUT (one-shot - tap SL UML_L, then one of these, then back
             * to default automatically)
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |       |       |       |       |       |       |-----------------------------------|       |  ue   |       |  oe   |       |       |
 * |       |  ae   | ss/AltGr|     |       |       |-----------------------------------|       |       |       |       |       |       |
 * |       |ss(win)|       |       |       |       |       |-------------------|       |       |       |       |       |       |       |
 *                                 |       |       |       |       |---|       |       |       |       |
 */

            bindings = <
&trans  &trans      &trans     &trans  &trans  &trans                                    &trans  &um_ue  &trans  &um_oe  &trans  &trans
&trans  &um_ae      &kp RA(S)  &trans  &trans  &trans                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &um_sz_win  &trans     &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                       &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adj_layer {
            if-layers = <1 2>;
            then-layer = <5>;
        };
    };
};
