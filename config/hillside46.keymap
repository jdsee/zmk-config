#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define QWERTY_L 0
#define DVORAK_L 1
#define COLEMK_L 2
#define NAV_L    3
#define SYM_L    4
#define ADJ_L    5
#define Undo   LC(Z)
#define Cut    LC(X)
#define Copy   LC(C)
#define Paste  LC(V)
#define Redo   LC(Y)

/ {
    behaviors {
        /* Re-tapping within this window after a tap always repeats the tap,
         * so holding the thumb keys for auto-repeat (GUI/BACKSPACE, TAB, ENTER)
         * works instead of triggering the hold behavior. Only applied to these
         * thumb-key variants, not the global &mt/&lt, so home-row CTRL/ESC etc.
         * keep the normal tap-hold decision.
         */

        mt_qt: mod_tap_quick_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            bindings = <&kp>, <&kp>;
        };

        lt_qt: layer_tap_quick_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        num_pad {
            bindings = <&mo 7>;
            key-positions = <15 14>;
        };

        lshift {
            bindings = <&sk LSHIFT>;
            key-positions = <15 16>;
        };

        rshift {
            bindings = <&sk RSHFT>;
            key-positions = <19 20>;
        };

        caps_lock {
            bindings = <&caps_word>;
            key-positions = <16 19>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* QWERTY
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | `     |   Q   |   W   |   E   |   R   |   T   |-----------------------------------|   Y   |   U   |   I   |   O   |   P   | BKSPC |
 * | TAB   |   A   |   S   |   D   |   F   |   G   |-----------------------------------|   H   |   J   |   K   |   L   |   ;   | ENTER |
 * | CTRL  |   Z   |   X   |   C   |   V   |   B   |  ESC  |-------------------|  CAPS |   N   |   M   |   ,   |   .   |   /   |   '   |
 *                                 |  GUI  |  ALT  |SK SHFT|  Nav  |---|  Sym  | SPACE |  ALT  |  GUI  |
 */

            bindings = <
&kp TAB               &kp Q  &kp W  &kp E  &kp R      &kp T                                                                                     &kp Y      &kp U  &kp I      &kp O    &kp P      &mt PLUS MINUS
&mt LEFT_CONTROL ESC  &kp A  &kp S  &kp D  &kp F      &kp G                                                                                     &kp H      &kp J  &kp K      &kp L    &kp SEMI   &kp SQT
&sk LALT              &kp Z  &kp X  &kp C  &kp V      &kp B          &mt K_APP C_PREV                                  &mt C_PLAY_PAUSE C_NEXT  &kp N      &kp M  &kp COMMA  &kp DOT  &kp SLASH  &kp RALT
                                           &kp LC(Z)  &kp BACKSPACE  &mt LEFT_GUI DEL  &lt_qt 2 TAB    &lt_qt 1 ENTER  &sk RSHIFT               &kp SPACE  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            /* NAV   
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | Copy  |   1   |   2   |   3   |   4   |   5   |-----------------------------------|   6   |   7   |   8   |   9   |   0   | BSPC  |
 * | Cut   |  GUI  |  Alt  | Ctrl  | Shift | Paste |-----------------------------------| PG UP |  Left |  Up   |  Down | Right | PG DN |
 * | Ctrl  |  F1   |  F2   |  F3   |  F4   |  F5   |  UnDo |-------------------| ReDo  |  F6   |  F7   |  F8   |  F9   |  F10  | Ctrl  |
 *                                 |       |       |       |       |---| ADJ_L |       |       |       |
 */

            bindings = <
&kp LSHIFT  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                                          &kp N6      &kp N7        &kp N8    &kp N9        &kp N0           &trans
&kp LCTRL   &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                                          &kp LEFT    &kp DOWN      &kp UP    &kp RIGHT     &kp RIGHT_SHIFT  &kp RCTRL
&trans      &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp RSHIFT                    &kp F12  &kp C_PREV  &kp C_VOL_DN  &kp C_PP  &kp C_VOL_UP  &kp C_NEXT       &trans
                                    &trans  &trans   &trans      &trans    &trans  &trans   &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_layer {
            /* SYM
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | INS   |   !   |   @   |   #   |   $   |   %   |-----------------------------------|   ^   |   &   |   *   |   (   |   )   | BSPC  |
 * |       |   \   |   -   |   =   |   [   |   ]   |-----------------------------------| HOME  | Shift | Ctrl  | Alt   | Gui   | END   |
 * | Ctrl  |   |   |   _   |   +   |   {   |   }   |SkAltGr|-------------------| MENU  | Mute  | Vol-  | Vol+  | Play  |       | Ctrl  |
 *                                 |       |       |       |  ADJ_L |---|      |       |       |       |
 */

            bindings = <
&kp TILDE  &kp EXCL       &kp AT          &kp HASH        &kp DOLLAR       &kp PERCENT                                          &kp CARET  &kp AMPS          &kp ASTRK          &kp LPAR   &kp RPAR       &kp PLUS
&kp LCTRL  &kp GRAVE      &kp MINUS       &kp LC(CARET)   &kp EQUAL        &kp GRAVE                                            &kp LEFT   &kp DOWN          &kp UP             &kp RIGHT  &kp PIPE       &kp RCTRL
&trans     &kp BACKSLASH  &kp LEFT_SHIFT  &kp LEFT_BRACE  &kp RIGHT_BRACE  &none        &trans                   &trans         &none      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SLASH  &kp BACKSLASH  &trans
                                                          &trans           &trans       &trans  &mo 3    &trans  &kp RIGHT_ALT  &trans     &kp K_APP
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adj_layer {
            /* ADJUST
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |       | QWERTY| DVORAK| COLEMK|       |       |-----------------------------------|       |  F11  |  F12  |Prt Scr|EP_OFF | EP_ON |
 * | RESET | BT 0  | BT 1  | BT 2  | BT 3  | BT 4  |-----------------------------------|       |       |       |       |       | RESET |
 * |       | LALT  | LGUI  | LCTRL | LSHIFT|       |BT CLR |-------------------|       |       |       |OUT_USB|OUT_BLE|       | BOOTL |
 *                                 |       |       |       |       |---|       |       |       |       |
 */

            bindings = <
&none       &to 0         &to 0         &to 0         &none         &none                                               &none   &kp F11  &kp F12       &kp PRINTSCREEN  &ext_power EP_OFF  &ext_power EP_ON
&sys_reset  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                        &none   &none    &none         &none            &none              &sys_reset
&none       &kp LALT      &kp LGUI      &kp LCTRL     &kp LSHIFT    &none         &bt BT_CLR                    &none   &none   &none    &out OUT_USB  &out OUT_BLE     &none              &bootloader
                                                      &trans        &trans        &trans      &trans    &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            /* NAV   
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | Copy  |   1   |   2   |   3   |   4   |   5   |-----------------------------------|   6   |   7   |   8   |   9   |   0   | BSPC  |
 * | Cut   |  GUI  |  Alt  | Ctrl  | Shift | Paste |-----------------------------------| PG UP |  Left |  Up   |  Down | Right | PG DN |
 * | Ctrl  |  F1   |  F2   |  F3   |  F4   |  F5   |  UnDo |-------------------| ReDo  |  F6   |  F7   |  F8   |  F9   |  F10  | Ctrl  |
 *                                 |       |       |       |       |---| ADJ_L |       |       |       |
 */

            bindings = <
&kp LG(W)     &kp LG(N1)      &kp LG(N2)      &kp LG(N3)      &kp LG(N4)      &kp LG(N5)                                                        &kp LG(N6)      &kp LG(N7)      &kp LG(N8)      &kp LG(N9)      &kp LG(LESS_THAN)  &kp LG(O)
&lt 5 ESCAPE  &kp LEFT_SHIFT  &kp LGUI        &kp LG(O)       &kp LG(F)       &kp LS(LG(SPACE))                                                 &kp LG(H)       &kp LG(J)       &kp LG(K)       &kp LG(L)       &kp LG(GT)         &kp RCTRL
&trans        &kp LS(LG(N1))  &kp LS(LG(N2))  &kp LS(LG(N3))  &kp LS(LG(N4))  &kp LG(LS(N5))     &kp Undo                   &kp Redo            &kp LS(LG(N6))  &kp LG(LS(N7))  &kp LG(LS(N8))  &kp LG(LS(N9))  &kp LG(LS(N0))     &trans
                                                              &trans          &trans             &trans    &trans    &mo 2  &lt_qt 5 LG(ENTER)  &kp LG(SPACE)   &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        nav_layer_2 {
            /* Escapes nav_layer back to default-layer typing with Alt held.
             * Outranks nav_layer (2) so its bindings win instead of nav_layer's,
             * everywhere nav_layer isn't already &trans.
             */

            bindings = <
&kp LG(LC(TAB))  &kp LG(LC(Q))  &kp LG(LC(W))  &kp LG(LC(E))  &kp LG(LC(R))  &kp LG(LC(T))                                        &kp LG(LC(Y))  &kp LG(LC(U))  &kp LG(LC(I))      &kp LG(LC(O))    &kp LG(LC(P))      &trans
&trans           &kp LG(LC(A))  &kp LG(LC(S))  &kp LG(LC(D))  &kp LG(LC(F))  &kp LG(LC(G))                                        &kp LG(LC(H))  &kp LG(LC(J))  &kp LG(LC(K))      &kp LG(LC(L))    &kp LG(LC(SEMI))   &kp LG(LC(SQT))
&trans           &kp LG(LC(Z))  &kp LG(LC(X))  &kp LG(LC(C))  &kp LG(LC(V))  &kp LG(LC(B))  &mo 7                     &caps_word  &kp LG(LC(N))  &kp LG(LC(M))  &kp LG(LC(COMMA))  &kp LG(LC(DOT))  &kp LG(LC(SLASH))  &trans
                                                              &trans         &trans         &trans  &trans    &trans  &trans      &trans         &trans
            >;
        };

        fn_layer {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                                     &kp F6   &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &trans  &trans  &trans  &trans  &kp F11                                    &kp F12  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans   &trans                    &trans  &trans   &trans  &trans  &trans  &trans   &trans
                                &trans  &trans   &trans  &trans    &trans  &trans  &trans   &trans
            >;
        };

        num_pad {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                                             &kp NUMBER_6   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0     &trans
&trans  &trans        &trans        &trans        &trans        &trans                                                   &kp MINUS      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS         &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans                       &trans        &kp KP_DIVIDE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_MULTIPLY  &trans
                                                  &trans        &trans        &trans  &trans    &kp EQUAL  &kp NUMBER_0  &trans         &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adj_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
