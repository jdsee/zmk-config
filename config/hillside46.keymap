#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include "keys_de.h"

#define QWERTY_L 0
#define DVORAK_L 1
#define COLEMK_L 2
#define NAV_L    3
#define SYM_L    4
#define ADJ_L    5
#define Undo   LC(DE_Z)
#define Cut    LC(X)
#define Copy   LC(C)
#define Paste  LC(V)
#define Redo   LC(DE_Y)

/ {
    behaviors {
        /* Re-tapping within this window after a tap always repeats the tap,
         * so holding the thumb keys for auto-repeat (GUI/BACKSPACE, TAB, ENTER)
         * works instead of triggering the hold behavior. Only applied to these
         * thumb-key variants, not the global &mt/&lt, so home-row CTRL/ESC etc.
         * keep the normal tap-hold decision.
         */

        mt_qt: mod_tap_quick_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            bindings = <&kp>, <&kp>;
        };

        uml_qt: umlaut_quick_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        lt_qt: layer_tap_quick_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <250>;
            bindings = <&mo>, <&kp>;
        };

        /* /, ; and ' already bake in Shift on a German layout, so a plain
         * &kp can't tell when Shift is also really held. */

        de_slash_qmark: mod_morph_de_slash_question {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_SLASH>, <&kp DE_QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        de_semi_colon: mod_morph_de_semi_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_SEMI>, <&kp DE_COLON>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        de_sqt_dqt: mod_morph_de_sqt_dqt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DE_SQT>, <&kp DE_DOUBLE_QUOTES>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        de_comma_lt: mod_morph_de_comma_lt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp DE_LESS_THAN>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        de_dot_gt: mod_morph_de_dot_gt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp DE_GREATER_THAN>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        lshift {
            bindings = <&kp LSHIFT>;
            key-positions = <15 16>;
        };

        rshift {
            bindings = <&kp RSHFT>;
            key-positions = <19 20>;
        };

        caps_lock {
            bindings = <&caps_word>;
            key-positions = <16 19>;
        };

        ctrl_on_sym_num {
            bindings = <&kp RCTRL>;
            key-positions = <41 23>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* QWERTY
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | `     |   Q   |   W   |   E   |   R   |   T   |-----------------------------------|   Y   |   U   |   I   |   O   |   P   | BKSPC |
 * | TAB   |   A   |   S   |   D   |   F   |   G   |-----------------------------------|   H   |   J   |   K   |   L   |   ;   | ENTER |
 * | CTRL  |   Z   |   X   |   C   |   V   |   B   |  ESC  |-------------------|  CAPS |   N   |   M   |   ,   |   .   |   /   |   '   |
 *                                 |  GUI  |  ALT  |SK SHFT|  Nav  |---|  Sym  | SPACE |  ALT  |  GUI  |
 */

            bindings = <
&kp TAB               &kp Q                     &kp W               &kp E  &kp R           &kp T                                                                                   &kp DE_Y   &uml_qt DE_U_UMLAUT DE_U  &kp I         &uml_qt DE_O_UMLAUT DE_O  &kp P            &kp DE_MINUS
&mt LEFT_CONTROL ESC  &uml_qt DE_A_UMLAUT DE_A  &uml_qt DE_SZ DE_S  &kp D  &kp F           &kp G                                                                                   &kp H      &kp J                     &kp K         &kp L                     &de_semi_colon   &de_sqt_dqt
&sk LALT              &kp DE_Z                  &kp X               &kp C  &kp V           &kp B          &mt C_PREV DEL                                  &mt C_PLAY_PAUSE C_NEXT  &kp N      &kp M                     &de_comma_lt  &de_dot_gt                &de_slash_qmark  &kp RALT
                                                                           &lt 5 LC(DE_Z)  &kp BACKSPACE  &kp LEFT_GUI    &lt_qt 6 TAB    &lt_qt 7 ENTER  &sk RSHIFT               &kp SPACE  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_sym_layer {
            bindings = <
&kp DE_TILDE  &kp N1              &kp N2        &kp N3             &kp N4              &kp N5                                                &kp N6        &kp N7               &kp N8                &kp N9                   &kp N0                    &kp DE_PLUS
&kp LCTRL     &kp DE_EXCLAMATION  &kp DE_AT     &kp DE_HASH        &kp DE_DOLLAR       &kp DE_PERCENT                                        &kp DE_CARET  &kp DE_AMPS          &kp DE_ASTRK          &kp DE_LEFT_PARENTHESIS  &kp DE_RIGHT_PARENTHESIS  &kp RCTRL
&trans        &kp DE_BACKSLASH    &kp DE_GRAVE  &kp DE_LEFT_BRACE  &kp DE_RIGHT_BRACE  &kp DE_EQUAL    &trans                    &trans      &kp DE_PIPE   &kp DE_LEFT_BRACKET  &kp DE_RIGHT_BRACKET  &kp DE_EQUAL             &kp DE_BACKSLASH          &trans
                                                                   &trans              &trans          &trans  &trans    &trans  &kp RSHIFT  &trans        &kp K_APP
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn_layer {
            /* NAV   
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | Copy  |   1   |   2   |   3   |   4   |   5   |-----------------------------------|   6   |   7   |   8   |   9   |   0   | BSPC  |
 * | Cut   |  GUI  |  Alt  | Ctrl  | Shift | Paste |-----------------------------------| PG UP |  Left |  Up   |  Down | Right | PG DN |
 * | Ctrl  |  F1   |  F2   |  F3   |  F4   |  F5   |  UnDo |-------------------| ReDo  |  F6   |  F7   |  F8   |  F9   |  F10  | Ctrl  |
 *                                 |       |       |       |       |---| ADJ_L |       |       |       |
 */

            bindings = <
&kp F12    &kp F1         &kp F2        &kp F3      &kp F4        &kp F5                                          &kp F6    &kp F7     &kp F8     &kp F9     &kp F10          &kp F11
&kp LCTRL  &kp C_BRI_DEC  &kp C_PREV    &kp C_PP    &kp C_NEXT    &kp C_BRI_UP                                    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp PRINTSCREEN  &kp RCTRL
&trans     &none          &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &none         &trans                    &trans  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &none            &trans
                                                    &trans        &trans        &trans  &trans    &trans  &trans  &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        adj_layer {
            /* ADJUST
 * -------------------------------------------------------------------------------------------------------------------------------------
 * |       | QWERTY| DVORAK| COLEMK|       |       |-----------------------------------|       |  F11  |  F12  |Prt Scr|EP_OFF | EP_ON |
 * | RESET | BT 0  | BT 1  | BT 2  | BT 3  | BT 4  |-----------------------------------|       |       |       |       |       | RESET |
 * |       | LALT  | LGUI  | LCTRL | LSHIFT|       |BT CLR |-------------------|       |       |       |OUT_USB|OUT_BLE|       | BOOTL |
 *                                 |       |       |       |       |---|       |       |       |       |
 */

            bindings = <
&none       &to 0         &to 0         &to 0         &none         &none                                                       &none         &kp F11       &kp F12       &kp PRINTSCREEN  &ext_power EP_OFF  &ext_power EP_ON
&sys_reset  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                                &out OUT_BLE  &out OUT_TOG  &out OUT_USB  &none            &none              &sys_reset
&none       &kp LALT      &kp LGUI      &kp LCTRL     &kp LSHIFT    &none         &bt BT_CLR                    &bt BT_CLR_ALL  &none         &none         &none         &none            &none              &bootloader
                                                      &trans        &trans        &trans      &trans    &trans  &trans          &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        sym_layer {
            /* SYM
 * -------------------------------------------------------------------------------------------------------------------------------------
 * | INS   |   !   |   @   |   #   |   $   |   %   |-----------------------------------|   ^   |   &   |   *   |   (   |   )   | BSPC  |
 * |       |   \   |   -   |   =   |   [   |   ]   |-----------------------------------| HOME  | Shift | Ctrl  | Alt   | Gui   | END   |
 * | Ctrl  |   |   |   _   |   +   |   {   |   }   |SkAltGr|-------------------| MENU  | Mute  | Vol-  | Vol+  | Play  |       | Ctrl  |
 *                                 |       |       |       |  ADJ_L |---|      |       |       |       |
 */

            bindings = <
&kp DE_TILDE  &kp DE_EXCL       &kp DE_AT       &kp DE_HASH        &kp DE_DOLLAR       &kp DE_PERCENT                                          &kp DE_CARET  &kp DE_AMPS          &kp DE_ASTRK          &kp DE_LPAR   &kp DE_RPAR       &kp DE_PLUS
&kp LCTRL     &kp DE_GRAVE      &kp DE_MINUS    &kp LC(DE_CARET)   &kp DE_EQUAL        &kp DE_GRAVE                                            &kp LEFT      &kp DOWN             &kp UP                &kp RIGHT     &kp DE_PIPE       &kp RCTRL
&trans        &kp DE_BACKSLASH  &kp LEFT_SHIFT  &kp DE_LEFT_BRACE  &kp DE_RIGHT_BRACE  &none           &trans                   &trans         &none         &kp DE_LEFT_BRACKET  &kp DE_RIGHT_BRACKET  &kp DE_SLASH  &kp DE_BACKSLASH  &trans
                                                                   &trans              &trans          &trans  &mo 3    &trans  &kp RIGHT_ALT  &trans        &kp K_APP
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        num_pad {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                                                &kp NUMBER_6   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0     &trans
&trans  &trans        &trans        &trans        &trans        &trans                                                      &kp DE_MINUS   &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp DE_PLUS      &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans                          &trans        &kp KP_DIVIDE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_MULTIPLY  &trans
                                                  &trans        &trans        &trans  &trans    &kp DE_EQUAL  &kp NUMBER_0  &trans         &trans
            >;
        };

        num_pad_media {
            bindings = <
&trans     &kp N1         &kp N2        &kp N3      &kp N4        &kp N5                                                 &kp N6     &kp N7  &kp N8  &kp N9  &kp N0  &trans
&kp LCTRL  &kp C_BRI_DEC  &kp C_PREV    &kp C_PP    &kp C_NEXT    &kp C_BRI_UP                                           &kp PLUS   &kp N4  &kp N5  &kp N6  &trans  &kp RCTRL
&trans     &none          &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &none         &trans                           &trans  &kp ASTRK  &kp N1  &kp N2  &kp N3  &trans  &trans
                                                    &trans        &trans        &trans  &trans    &kp BACKSPACE  &kp N0  &trans     &trans
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sym_nav {
            bindings = <
&kp DE_TILDE  &kp DE_EXCL       &kp DE_AT  &kp DE_HASH  &kp DE_DOLLAR  &kp DE_PERCENT                                           &kp DE_CARET  &kp DE_AMPS          &kp DE_ASTRK          &kp DE_LPAR   &kp DE_RPAR       &kp DE_PLUS
&kp LCTRL     &kp DE_GRAVE      &kp DE_LT  &kp DE_LPAR  &kp DE_LBKT    &kp DE_LBRC                                              &kp LEFT      &kp DOWN             &kp UP                &kp RIGHT     &kp GRAVE         &kp RCTRL
&trans        &kp DE_BACKSLASH  &kp DE_GT  &kp DE_RPAR  &kp DE_RBKT    &kp DE_RBRC     &trans                    &trans         &kp PIPE      &kp DE_LEFT_BRACKET  &kp DE_RIGHT_BRACKET  &kp DE_SLASH  &kp DE_BACKSLASH  &trans
                                                        &trans         &trans          &trans  &trans    &trans  &kp RIGHT_ALT  &trans        &kp K_APP
            >;

            sensor-bindings =
                <&inc_dec_kp PG_UP PG_DN>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fn_keys {
            bindings = <
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans                                    &kp F10  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &trans                                    &kp F11  &kp F4  &kp F5  &kp F6  &kp F11  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &trans  &trans                    &trans  &kp F12  &kp F1  &kp F2  &kp F3  &kp F12  &trans
                                  &trans   &trans  &trans  &trans    &trans  &trans  &trans   &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adj_layer {
            if-layers = <6 7>;
            then-layer = <3>;
        };
    };
};
